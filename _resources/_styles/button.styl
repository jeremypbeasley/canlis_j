.Button {
  background: black;
  color: white;
  padding: 15px 20px;
  border-radius: 1000px;
}

/* ==========================================================
   Brand Button
   ========================================================== */

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 0;
  box-sizing: border-box;
  min-height: 3.5rem;
  padding: 1rem 1.7rem;
  font: inherit;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition:
    color .18s ease,
    background-color .18s ease,
    transform .12s ease;
}

.brand-button:hover {
  transform: translateY(-1px);
}

.brand-button:active {
  transform: translateY(0);
}

/* ==========================================================
   Front Surface
   ========================================================== */

.brand-button::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  box-sizing: border-box;
  background: var(--button-fill);
  /* border: 1px solid var(--button-border); */
}

/* ==========================================================
   Offset Outline
   ========================================================== */

.brand-button::after {
  content: "";
  position: absolute;
  top: 5px;
  left: 5px;
  right: -5px;
  bottom: -5px;
  z-index: -2;
  box-sizing: border-box;
  /* border: 1px solid var(--button-border); */
}

/* ==========================================================
   Dark Theme
   ========================================================== */

.brand-button--dark {
  --button-border: brand-color-1;
}

.brand-button--dark.brand-button--solid {
  --button-fill: brand-color-1;
  color: white;
}

.brand-button--dark.brand-button--transparent {
  --button-fill: var(--surface-color);
  color: brand-color-1;
}

/* ==========================================================
   Light Theme
   ========================================================== */

.brand-button--light {
  --button-border: white;
}

.brand-button--light.brand-button--solid {
  --button-fill: white;
  color: brand-color-1;
}

.brand-button--light.brand-button--transparent {
  --button-fill: var(--surface-color);
  color: white;
}
