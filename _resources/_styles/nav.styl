/* ==========================================================================
   NAV
   ========================================================================== */

.site-nav {
  position: relative;
  z-index: 100;

  display: flex;
  align-items: center;
  /* justify-content: space-between; */

  height: 110px;
  padding: 0 3rem;

  /* background: red; */
  border-bottom: 1px solid brand-color-4;
  /* margin-top: 90px */
}

..home .home-opening-step-1 {
  display: none !important;
  opacity: 0 !important;
}


/* ==========================================================================
   LOGO
   ========================================================================== */

.site-nav-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  margin: 0;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  /* display: none; */
}

body.home .site-nav-logo {
  display: none;
}


/* ==========================================================================
   RESERVE BUTTON
   ========================================================================== */

.site-nav-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(70, 70, 60, .4);
  border-radius: 5px;

  text-decoration: none;
}


/* ==========================================================================
   DESKTOP RIGHT SIDE
   ========================================================================== */

.site-nav-links {
  display: flex;
  align-items: center;
  gap: 4rem;

  margin-left: auto;
}

.site-nav-links > a {
  text-decoration: none;
}


/* ==========================================================================
   MOBILE RIGHT SIDE
   ========================================================================== */

.site-nav-mobile {
  display: none;
  align-items: center;

  /* margin-left: auto; */
  margin-left: 2em;
}


/* ==========================================================================
   EXPLORE
   ========================================================================== */

.site-nav-explore {
  position: relative;

  margin: 0;
  padding: 0;
}

.site-nav-explore summary {
  list-style: none;
}

.site-nav-explore summary::-webkit-details-marker {
  display: none;
}

.site-nav-trigger {
  display: flex;
  align-items: center;
  gap: .45rem;
  margin-right: 1rem;
  cursor: pointer;
  user-select: none;
}


/* ==========================================================================
   CARET
   ========================================================================== */

.site-nav-caret {
  position: relative;

  width: 8px;
  height: 8px;

  margin-top: -6px;

  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;

  transform: rotate(45deg);

  transition:
    transform .18s ease,
    margin-top .18s ease;
}

.site-nav-explore[open] .site-nav-caret {
  margin-top: 2px;

  transform: rotate(225deg);
}


/* ==========================================================================
   DROPDOWN
   ========================================================================== */

.site-nav-dropdown {
  position: absolute;
  top: calc(100% + 18px);
  left: 50%;

  min-width: 180px;
  padding: 18px 24px 8px;

  background: brand-color-2;

  transform: translateX(-50%);

  box-shadow:
    0 5px 10px rgba(0, 0, 0, .08),
    0 15px 35px rgba(0, 0, 0, .14);
}


/* Dropdown arrow */

.site-nav-dropdown::before {
  content: "";

  position: absolute;
  bottom: 100%;
  left: 50%;

  border: 8px solid transparent;
  border-bottom-color: brand-color-2;

  transform: translateX(-50%);
}


/* ==========================================================================
   MENU ITEMS
   ========================================================================== */

.site-nav-dropdown ul {
  margin: 0;
  padding: 0;

  list-style: none;
}

.site-nav-dropdown li + li {
  margin-top: .65rem;
}

.site-nav-dropdown a {
  display: block;

  color: white;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;

  transition: opacity .15s ease;
}

.site-nav-dropdown a:hover {
  opacity: .65;
}


/* ==========================================================================
   ACCESSIBILITY
   ========================================================================== */

.site-nav-trigger:hover {
  opacity: .7;
}

.site-nav-trigger:focus-visible,
.site-nav a:focus-visible {
  outline: 1px solid currentColor;
  outline-offset: 4px;
}


/* ==========================================================================
   MOBILE
   ========================================================================== */

@media (max-width: 767px) {

  .site-nav {
    height: 80px;
    padding: 0 1rem;
  }

  .site-nav-desktop {
    display: none;
  }

  .site-nav-mobile {
    display: flex;
  }

  .site-nav-button {
    padding: .55rem .8rem;
  }

  .site-nav-dropdown-mobile {
    right: 0;
    left: auto;

    min-width: 210px;

    transform: none;
  }

  .site-nav-dropdown-mobile::before {
    right: 18px;
    left: auto;

    transform: none;
  }
}
