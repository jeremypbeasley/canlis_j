
/* BEGIN OPENING SEQUENCE */


/* Testing: Comment out all declarations after this one and change opacity to 1 to test without animation */

.home .home-opening-step-1,
.home .home-opening-step-2,
.home .home-opening-step-3,
.home .home-opening-step-4,
.home .home-opening-step-5,
.home .site-nav {
  opacity: 0;
}

/* Step 1: fade in, remain briefly, then fade out */
.home .home-opening-step-1 {
  position: absolute;
  top: 45%;
  z-index: 99;
  width: 70%;
  /* background: red; */
  margin: 0 15%;
  animation: step-1 4s ease 200ms forwards;
  text-align: center;
  left: 0;
}

@media laptop {
  .home .home-opening-step-1 {
    width: 100%;
    top: 50%;
    margin: 0;
  }
}

/* Step 2: logo fades in and stays */
.home .home-opening-step-2 {
  animation: step-stay 0.6s ease 4.2s forwards;
}

/* Step 3: background fades in and stays */
.home .home-opening-step-3 {
  animation: step-stay 2s ease 7s forwards;
}

/*
Step 4 must not retain an animated opacity value.

Its normal state is opacity: 1.
"backwards" applies opacity: 0 during the delay, but releases
the animation's stacking context after the animation finishes.
*/
.home .home-opening-step-4 {
  position: relative;
  opacity: 1;
  animation: step-stay 1.2s ease 5s backwards;
}

.home .home-opening-step-5 {
  opacity: 1;
  animation: step-stay 1.2s ease 5.2s backwards;
}

/* Navigation can retain its final animation state */
.home .site-nav {
  animation: step-stay 1.2s ease 5s forwards;
}

/* END OPENING SEQUENCE */
